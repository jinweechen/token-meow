  "change": {
    "problem": "A resource monitor could terminate the owned bridge while idle, leaving account/directory public state looking connected until the next120/600-second reader boundary.",
    "behavior": "The existing account-worker loop now observes the authoritative latched resource stop and reaps only its owned transport without RPC/startup/retry. It patches only current cache status/error: stale when collectedAt exists, unavailable otherwise. Same-source/same-generation directory lastSuccess/count remain historical while status becomes unavailable.",
    "ownership": "Full binding and captured generation are checked under account/core/cache/metrics order. Manual retry cannot publish a fresh read before an older stop is applied; clear or source changes invalidate the old token. Metrics remains locked through conditional persistence after releasing other guards; only visible changes emit.",
    "generationFix": "Every complete-binding rebind, including first bind, increments generation; same-id root/adapter/environment changes and A-to-B-to-A visits cannot reuse a prior directory generation or accept a late prior reply. Explicit clear continues to increment generation.",
    "preserved": [
      "96MiB warning and128MiB hard limit",
      "shared resource fuse and explicit-manual-retry-only reset",
      "10-second manual throttle and120/600-second reader schedules",
      "quota/usage/identity and collection/attempt timestamps during observation",
      "disabled and unsupported adapter error semantics",
      "bounded independent diagnostic evidence; source switch/clear do not reset resource stop",
      "idempotent observation without repeated emit/persist"
    ],
    "cadenceScope": "Approximately1 second is the existing worker code cadence when idle, not a measured Native status-propagation latency. Blocking existing work can occupy that worker; no new timer/thread was added."
  },
